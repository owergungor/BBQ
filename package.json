{
  "name": "bbq-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BBQ — Lightweight, cross-platform desktop productivity island",
  "author": "BBQ Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bbq/desktop dev",
    "build": "pnpm --filter @bbq/types build && pnpm --filter @bbq/desktop build",
    "typecheck": "pnpm --filter @bbq/types typecheck && pnpm --filter @bbq/desktop typecheck",
    "test": "pnpm --filter @bbq/desktop test",
    "lint": "pnpm --filter @bbq/desktop lint",
    "tauri": "pnpm --filter @bbq/desktop tauri",
    "cargo:check": "cargo check --workspace",
    "cargo:test": "cargo test --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt --all -- --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  }
}
